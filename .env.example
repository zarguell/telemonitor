# Telemonitor environment configuration (copy to .env for local overrides)

# --- Database (plain psycopg URL; Procrastinate reads DATABASE_URL directly) ---
DATABASE_URL=postgresql://telemonitor:telemonitor@db:5432/telemonitor
TM_DATABASE_URL=postgresql+psycopg://telemonitor:telemonitor@db:5432/telemonitor

# --- At-rest encryption (Fernet key, urlsafe base64, 32 bytes) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Deployment secret management MUST supply this in production. Never in the UI.
# NOTE: the key baked into docker-compose.yml is a DEV-ONLY test value committed
# for local runs. Never use it (or authorize a real Telegram account) outside
# local development — anyone with the repo can decrypt dev-encrypted secrets.
TM_SECRET_KEY=

# --- Auth ---
# All of the below are REQUIRED with no defaults — generate fresh values and
# keep them in your gitignored .env:
#   TM_SECRET_KEY:        python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   TM_AUTH_SECRET:       python -c "import secrets; print(secrets.token_urlsafe(32))"
#   TM_COLLECTOR_CONTROL_TOKEN: python -c "import secrets; print(secrets.token_urlsafe(24))"
#   TM_SEED_ADMIN_PASSWORD:     python -c "import secrets; print(secrets.token_urlsafe(18))"
TM_AUTH_SECRET=
TM_COLLECTOR_CONTROL_TOKEN=
TM_SEED_ADMIN_PASSWORD=
TM_AUTH_TTL_HOURS=12

# --- Telegram ---
# Set to 1 to run the simulated Telegram account (no real credentials needed).
# Set to 0 to use real Telethon with credentials entered in the UI.
TM_SIMULATE_TELEGRAM=1

# --- Collector internal control API (never exposed to the browser) ---
# REQUIRED, no default (see generation one-liners above)
TM_COLLECTOR_CONTROL_PORT=9001

# --- Logging / misc ---
TM_LOG_LEVEL=INFO
TM_REDACT_LOGGING=1
TM_ENVIRONMENT=development
TM_MEDIA_STORE=local
TM_MEDIA_DIR=/data/media
TM_MEDIA_MAX_BYTES=10485760
